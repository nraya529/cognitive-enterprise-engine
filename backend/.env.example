ANTHROPIC_API_KEY=

EXTRACTION_MODEL=claude-opus-4-7
VERIFICATION_MODEL=claude-sonnet-4-6
COMMUNICATIONS_MODEL=claude-sonnet-4-6
PROSPECTING_MODEL=claude-sonnet-4-6

MAX_SELF_HEAL_ATTEMPTS=3
FUZZY_MATCH_THRESHOLD=85

DATABASE_URL=sqlite+aiosqlite:///./nexus_growth.db

TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced

RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
OUTBOUND_FROM_EMAIL="Project Nexus <outreach@example.com>"
OUTBOUND_REPLY_TO_EMAIL=
